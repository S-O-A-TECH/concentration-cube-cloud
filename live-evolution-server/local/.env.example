# live-evolution 서버 설정 (.env 로 복사해 사용)
# 값 변경 후 서버 재시작 필요. 화면(설정)은 이 값들을 안내만 하고 수정하지 않는다 (E1 §1.4).

# 운영 서버 (다른 팀이 Docker 로 개발 중 — S5 완성 전에는 mock 사용: python run_mock_ops.py)
SERVER_URL=http://127.0.0.1:8100
EVOLUTION_TOKEN=dev-evolution-token

# 자체 로그인 (SPEC-04 §1 — 운영 서버 OPS 계정과 별개)
ADMIN_ID=admin
ADMIN_PW=1234

# 기기 (웹캠 프로토 로컬 API — SPEC-05 §2)
DEVICE_URL=http://127.0.0.1:8123

# AI 에이전트 기본값 (화면 설정에서 변경 가능 — settings 테이블이 우선)
AGENT_DEFAULT=claude
AGENT_TIMEOUT_SEC=600
DAILY_RUN_LIMIT=20

# 라벨 누적 트리거 N (SPEC-02 §2)
TRIGGER_N=5

# 웹캠 프로토 루트 (분류 코어 동기화 해시 검사·mock 채점용 — 상대/절대 경로 모두 허용)
WEBCAM_ROOT=../../web_cam_version_prototype

# 쿠키 서명 키 — 비우면 최초 기동 시 자동 생성되어 state/secret.key 에 보존
SECRET_KEY=
