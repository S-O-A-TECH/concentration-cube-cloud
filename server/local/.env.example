# .env 로 복사해서 사용 (.env 는 절대 커밋 금지 — .gitignore 에 포함)
# 아래 기본값은 '호스트 직접 실행 모드'(README 실행법 ②) 기준.
# docker compose 는 컨테이너 내부 주소(postgres/redis 호스트명)로 자동 덮어쓴다.

DATABASE_URL=postgresql+psycopg://cube:cube_dev_pw@127.0.0.1:5433/cube
REDIS_URL=redis://127.0.0.1:6380/0
STORAGE_ROOT=./data/storage
APP_VERSION=dev

# compose 가 postgres 컨테이너 초기화에 사용
POSTGRES_USER=cube
POSTGRES_PASSWORD=cube_dev_pw
POSTGRES_DB=cube

# ---- LLM 리포트 (S3, 선택) — worker 전용, 수치 요약만 전송 ----
# Qwen (Alibaba Cloud Model Studio, OpenAI 호환). 워크스페이스 전용 URL 사용 시 교체.
LLM_REPORT_ENABLED=false
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---- 시크릿 자리 (실값으로 교체) ----
OPS_ADMIN_ID=admin
OPS_ADMIN_PW=change-me
EVOLUTION_TOKEN=change-me
JWT_SECRET=change-me
