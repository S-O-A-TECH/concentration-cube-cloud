# Alibaba Cloud ECS 배포용 환경변수 — 이 파일을 .env 로 복사해서 채운다.
#   cp .env.cloud.example .env && nano .env
# .env 는 절대 커밋하지 않는다. change-me 가 하나라도 남아 있으면 배포하지 말 것.
#
# 강한 값 만들기:  openssl rand -hex 24
# 참고: docker-compose.cloud.yml 은 시크릿에 기본값을 주지 않는다.
#       비워 두면 컨테이너가 뜨지 않고 어떤 변수가 비었는지 알려 준다.

# ── PostgreSQL (컨테이너 내부 전용 — 외부 노출 안 함) ──────────────────────
POSTGRES_USER=cube
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=cube

# ── 운영 서버(8100) 시크릿 ────────────────────────────────────────────────
# OPS 관리자 계정 — 운영 콘솔 로그인
OPS_ADMIN_ID=admin
OPS_ADMIN_PW=change-me-ops-password
# API 토큰 서명 키
JWT_SECRET=change-me-jwt-secret
# 두 서버가 공유하는 값 — 자가진화 서버가 /v1/evolution/* 호출 시 사용.
# 한쪽만 바꾸면 진화 서버의 ops 상태가 인증 실패로 표시된다.
EVOLUTION_TOKEN=change-me-evolution-token

# 이미지/배포 식별용 — /health 응답의 version 에 그대로 나온다
APP_VERSION=cloud

# ── 자가진화 서버(8200) 자체 로그인 (SPEC-04 §1 — OPS 계정과 별개) ─────────
EVO_ADMIN_ID=admin
EVO_ADMIN_PW=change-me-evolution-password
# 쿠키 서명 키. 비워 두면 최초 기동 시 자동 생성되어 state 볼륨에 보존된다.
# 여러 인스턴스로 늘릴 계획이면 여기에 고정값을 넣는다.
EVO_SECRET_KEY=

# ── Qwen (Alibaba Cloud Model Studio, OpenAI 호환) ────────────────────────
# 두 서버가 같은 키·같은 워크스페이스를 쓰되, **모델은 역할별로 다르게** 쓴다.
# 모델별로 무료 쿼터(각 1,000,000 토큰)가 독립이라 역할 분리가 곧 쿼터 분산이다.
#
# ★ 키·URL·모델은 반드시 "한 세트". 키가 발급된 워크스페이스의 URL 이 아니거나
#   그 워크스페이스에서 승인(Authorization & Throttling)되지 않은 모델 id 를 쓰면
#   AccessDenied.Unpurchased / 404 로 실패한다 (verify_deployment.sh 4번 검사가 여기서 걸린다).
#
# QWEN_BASE_URL: 전용 워크스페이스를 만들었다면 콘솔의 API Host 를 그대로 쓴다 —
#   https://ws-<your-workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# 기본(Default) 워크스페이스만 쓴다면 아래 공용 국제 엔드포인트 그대로 두면 된다.
QWEN_API_KEY=change-me-qwen-api-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 코치(운영 서버) — 3개국어 학습 리포트 생성
QWEN_COACH_MODEL=qwen3.7-plus
# 제안자(진화 서버) — 채점 파라미터 개선 제안. 플래그십으로 추론 품질 확보
QWEN_EVOLVE_MODEL=qwen3.7-max
# 운영 서버의 세션 LLM 리포트 on/off (worker 전용, 수치 요약만 전송)
LLM_REPORT_ENABLED=true

# ── 자가진화 루프 동작 (기본값으로 두어도 무방) ───────────────────────────
AGENT_DEFAULT=qwen
AGENT_TIMEOUT_SEC=600
DAILY_RUN_LIMIT=20
TRIGGER_N=5
# 실기기(웹캠 프로토)는 ECS 에 없다. 화면에 "기기 연결 안 됨"으로 뜰 뿐 정상이다.
DEVICE_URL=http://127.0.0.1:8123
